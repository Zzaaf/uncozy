generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 BigInt            @id @default(autoincrement())
  publicId           String            @unique @map("public_id")
  username           String            @unique
  email              String            @unique
  passwordHash       String
  gamesPlayed        Int               @default(0)
  highScore          Int               @default(0)
  totalKills         Int               @default(0) @map("total_kills")
  crawlersKilled     Int               @default(0) @map("crawlers_killed")
  flyersKilled       Int               @default(0) @map("flyers_killed")
  shootersKilled     Int               @default(0) @map("shooters_killed")
  droppersKilled     Int               @default(0) @map("droppers_killed")
  barriersDestroyed  Int               @default(0) @map("barriers_destroyed")
  maxLevelReached    Int               @default(0) @map("max_level_reached")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  achievements       UserAchievement[]

  @@map("users")
}

model Achievement {
  id          Int               @id @default(autoincrement())
  code        String            @unique
  nameRu      String            @map("name_ru")
  nameEn      String            @map("name_en")
  descRu      String            @map("desc_ru")
  descEn      String            @map("desc_en")
  points      Int               @default(10)
  isHidden    Boolean           @default(false) @map("is_hidden")
  sortOrder   Int               @default(0) @map("sort_order")
  createdAt   DateTime          @default(now())
  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId        BigInt      @map("user_id")
  achievementId Int         @map("achievement_id")
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")
  progress      Int?

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@index([achievementId])
  @@index([unlockedAt])
  @@map("user_achievements")
}
